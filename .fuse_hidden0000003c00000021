  <style>
    .page-hero {
      background-size: contain;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 400px;
      max-height: 600px;
      height: auto;
      position: relative;
      margin-top: -2rem;
      aspect-ratio: 16 / 9;
    }
    .page-hero-tint {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.3);
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
      auto-rows: auto;
      gap: 10px;
      padding: 0;
      background-color: var(--bg);
      grid-auto-flow: dense;
    }

    .gallery-item.landscape {
      grid-column: span 2;
    }

    @supports not (grid-template-columns: subgrid) {
      .gallery-item.landscape {
        grid-column: span 1;
      }
    }

    .gallery-item {
      position: relative;
      overflow: visible;
      border-radius: 0;
      cursor: pointer;
      transition: filter 0.3s ease;
      background: transparent;
      display: block;
      aspect-ratio: auto;
    }

    .gallery-item:hover {
      filter: brightness(1.1);
    }

    .gallery-item img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }

    @media (max-width: 1024px) {
      .gallery-grid {
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      }
    }

    @media (max-width: 768px) {
      .page-hero {
        aspect-ratio: 16 / 9;
      }
      .gallery-grid {
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      }
    }

    @media (max-width: 600px) {
      .page-hero {
        aspect-ratio: 4 / 3;
      }
      .gallery-grid {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 0.8rem;
        padding: 1.5rem 6%;
      }
    }
  </style>
</head>
